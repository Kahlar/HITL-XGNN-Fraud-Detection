# ==============================================================================
# Multi-Stage Dockerfile for HITL-XGNN Frontend Dashboard
# ==============================================================================

# Stage 1: Build production React assets
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY src/module6_api/frontend/package.json /app/package.json
RUN npm install

# Copy frontend source code
COPY src/module6_api/frontend/ /app/

# Configurable build-time API base URL
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Build static production bundle
RUN npm run build

# Stage 2: Serve with lean Nginx image
FROM nginx:1.27-alpine AS runner

# Remove default nginx html files
RUN rm -rf /usr/share/nginx/html/*

# Copy built static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -qO- http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
